# Copy to .env.local (ignored by Git) and fill in both values to enable
# automatic startup with npm run dev / npm run preview.
# Commands run with your host user's permissions, not in a sandbox.
SLADE_SHELL_ROOT=
SLADE_SHELL_TOKEN=

# Generate a token locally:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Never use a VITE_ prefix for the token: those variables are browser-visible.

SLADE_SHELL_PORT=8788
# Set false only when running a separate, manually managed shell service.
SLADE_SHELL_AUTOSTART=true
